# ---------- Site ----------
# Public origin, no trailing slash. Used for canonical URLs and the CSRF origin check.
SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=ClipVault
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# ---------- Networking ----------
# Set to "true" ONLY when running behind a proxy/CDN you control (Vercel, Cloudflare, nginx)
# that overwrites X-Forwarded-For. If false, client IP is not trusted and all clients share one bucket.
TRUST_PROXY=false

# ---------- Database (optional) ----------
# Without DATABASE_URL the job store is in memory (single process, lost on restart).
# Required if you run the worker as a separate process.
DATABASE_URL=
DATABASE_SSL=false

# ---------- Rate limiting ----------
# Optional Upstash Redis REST credentials. Without them an in-memory limiter is used (per instance).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ANALYZE_RATE_LIMIT=20          # requests per window per client
DOWNLOAD_RATE_LIMIT=8          # download jobs per window per client
RATE_LIMIT_WINDOW_SECONDS=60
COOLDOWN_SECONDS=300           # extra block after repeatedly hitting the limit

# ---------- Retrieval providers ----------
# Default off. yt-dlp is an open-source extractor that needs the yt-dlp binary installed on the host.
# Using it may conflict with the terms of the source platforms. Read README "Legal & platform risk".
YTDLP_ENABLED=false
YTDLP_PATH=yt-dlp
# Optional: Instagram oEmbed needs a Meta app access token ("APP_ID|APP_SECRET" or a client token).
INSTAGRAM_OEMBED_TOKEN=
PROVIDER_TIMEOUT_MS=25000
MAX_FILE_SIZE_MB=300

# ---------- Jobs & storage ----------
DOWNLOAD_DIR=./downloads
JOB_TTL_MINUTES=30             # temp files are deleted after this
JOB_CONCURRENCY=2
# "inline": the web process runs jobs. "external": only workers run jobs (needs DATABASE_URL + shared DOWNLOAD_DIR)
JOB_MODE=inline

# ---------- Admin / monitoring ----------
# Generate: openssl rand -base64 48   (min 32 chars). Leave empty to disable the admin API entirely.
ADMIN_TOKEN=

# ---------- Analytics ----------
NEXT_PUBLIC_ANALYTICS_ENABLED=false
